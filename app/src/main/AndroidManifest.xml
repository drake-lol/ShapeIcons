<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Launchers must hold this to read icons from the provider (normal level: granted at install, no prompt). -->
    <permission android:name="lol.drake.shapeicons.permission.READ_ICONS" android:protectionLevel="normal"/>

    <!-- lets the renderer fetch the app icon of installed launchable apps that the pack has no glyph for -->
    <queries>
        <intent><action android:name="app.lawnchair.APPLY_ICONS"/></intent>
        <package android:name="ginlemon.flowerfree"/>
        <package android:name="app.lawnchair"/>
        <package android:name="app.lawnchair.nightly"/>
        <package android:name="app.lawnchair.debug"/>
        <package android:name="com.teslacoilsw.launcher"/>
        <package android:name="bitpit.launcher"/>
        <package android:name="de.mm20.launcher2.release"/>
        <package android:name="com.microsoft.launcher"/>
        <package android:name="com.actionlauncher.playstore"/>
        <package android:name="com.anddoes.launcher"/>
        <package android:name="org.adw.launcher"/>
        <package android:name="org.adw.launcher.one"/>
        <package android:name="com.samsung.android.themedesigner"/>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>

    <application android:label="Shape Icons" android:icon="@drawable/icon_pack" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true" android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Dynamic path: launchers that know this scheme query icons here and re-query on ICON_PACK_CHANGED / provider notify. -->
        <provider
            android:name=".DynamicIconProvider"
            android:authorities="lol.drake.shapeicons.provider"
            android:exported="true"
            android:readPermission="lol.drake.shapeicons.permission.READ_ICONS"/>

        <!-- Smart Launcher's icon-generator contract: the authority MUST be "<package>.iconprovider". No permission:
             Smart Launcher doesn't hold ours, and the provider only ever serves icons. -->
        <provider
            android:name=".IconGeneratorProvider"
            android:authorities="lol.drake.shapeicons.iconprovider"
            android:exported="true"/>

        <!-- Makes Smart Launcher list this pack in its icon-pack picker (MAIN + its private ICONPROVIDER category). -->
        <activity-alias android:name=".SmartLauncherPack" android:targetActivity=".MainActivity" android:exported="true"
            android:label="Shape Icons (dynamic)">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="ginlemon.smartlauncher.ICONPROVIDER"/>
            </intent-filter>
        </activity-alias>

        <receiver android:name=".AuthReceiver" android:exported="true">
            <intent-filter>
                <action android:name="ginlemon.icongenerator.igAuthorizedToUpdate"/>
                <action android:name="ginlemon.icongenerator.igNotAuthorizedToUpdate"/>
            </intent-filter>
        </receiver>

        <!-- Static fallback: makes ordinary launchers list this APK as an icon pack and read res/xml/appfilter.xml.
             One filter per discovery convention, mirroring Lawnicons (which Lawnchair, Nova, Apex, ADW, Go, Atom accept). -->
        <activity-alias android:name=".IconPack" android:targetActivity=".MainActivity" android:exported="true">
            <intent-filter>   <!-- ADW; Theme Park on One UI -->
                <action android:name="org.adw.launcher.THEMES"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>   <!-- Nova; Lawnchair -->
                <action android:name="com.novalauncher.THEME"/>
                <category android:name="com.novalauncher.category.CUSTOM_ICON_PICKER"/>
            </intent-filter>
            <intent-filter>   <!-- Nova, plain action form -->
                <action android:name="com.novalauncher.THEME"/>
            </intent-filter>
            <intent-filter>   <!-- Apex; Lawnchair -->
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="com.anddoes.launcher.THEME"/>
            </intent-filter>
            <intent-filter>
                <action android:name="com.anddoes.launcher.THEME"/>
            </intent-filter>
            <intent-filter>   <!-- GO Launcher -->
                <action android:name="android.intent.action.MAIN"/>
                <action android:name="com.gau.go.launcherex.theme"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>   <!-- Lawnchair themed-icon source (Material You icons) -->
                <action android:name="app.lawnchair.icons.THEMED_ICON"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>   <!-- Kvaesitso -->
                <action android:name="org.adw.ActivityStarter.THEMES"/>
            </intent-filter>
            <intent-filter>   <!-- Motorola launcher -->
                <action android:name="com.motorola.launcher.ACTION_ICON_PACK"/>
            </intent-filter>
            <intent-filter>   <!-- Atom -->
                <action android:name="com.dlto.atom.launcher.THEME"/>
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
